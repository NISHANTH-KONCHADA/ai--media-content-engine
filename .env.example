# Environment Configuration — AI Social Media Marketing & Content Engine
# The system operates 100% locally with zero required external API keys (direct cost ₹0).
# Optional local or hosted model adapters can be configured below.

# --- SERVER CONFIGURATION ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./engine.db

# --- LOCAL INFERENCE (OPTIONAL) ---
# Ollama local inference endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ComfyUI local endpoint (optional for diffusion generation)
COMFYUI_BASE_URL=http://127.0.0.1:8188

# --- HOSTED FREE-TIER ADAPTERS (DISABLED BY DEFAULT) ---
# Optional fallback adapter for Groq free-tier (requires user-supplied API key; rate limits apply)
ENABLE_GROQ_ADAPTER=false
GROQ_API_KEY=

# --- BRAND WORKSPACE DEFAULTS ---
BRAND_NAME=IncuBrix
BRAND_TAGLINE="AI-Assisted Workflow & Content Engine for Modern Creators"
BRAND_PRIMARY_COLOR="#4F46E5"
BRAND_SECONDARY_COLOR="#06B6D4"
BRAND_ACCENT_COLOR="#10B981"
DEFAULT_TARGET_AUDIENCE="Podcasters, YouTubers, Expert Educators, and Content Operations Teams in US, CA, UK, IE, AU, NZ, SG"

# --- OUTPUT AND STORAGE ---
OUTPUT_DIR=./submission
ENABLE_DETERMINISTIC_FALLBACK=true
